<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:MyApp2.ViewModels"
    xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
    x:Class="MyApp2.Views.BuyListView"
    x:DataType="vm:BuyListViewModel">

    <Grid RowDefinitions="Auto,*" Margin="10">
        <!-- Title -->
        <TextBlock Text="BuyList Page" FontSize="24" HorizontalAlignment="Center" Grid.Row="0"/>

        <!-- Image gallery -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="10">
                <!-- Images -->
                <ItemsControl ItemsSource="{Binding Images}">
                    <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="Bitmap">
                            <Border Width="150" Height="150" BorderBrush="Gray" BorderThickness="2" Margin="5">
                                <Image Source="{Binding}" Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add Image button -->
                <Button Command="{Binding UploadImageCommand}" Width="150" Height="150" Background="LightGray" BorderBrush="Gray" BorderThickness="2" Margin="5">
                    <TextBlock Text="+" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
